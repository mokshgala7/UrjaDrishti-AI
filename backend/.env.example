# Flask Server Settings
FLASK_APP=app.py
PORT=5000
HOST=0.0.0.0
DEBUG=True
SECRET_KEY=change-this-in-production-secret-key-2026

# Paths (defaults point to project relative paths)
# DATA_DIR=/path/to/UrjaDrishti-AI/ml/data
# ARTIFACTS_DIR=/path/to/UrjaDrishti-AI/ml/artifacts

# Database (defaults to local SQLite at backend/database/urjadrishti.db)
# DATABASE_URL=sqlite:///backend/database/urjadrishti.db
# Or MySQL: DATABASE_URL=mysql+pymysql://user:password@localhost:3306/urjadrishti

# CORS Allowed Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,*

# Environmental Baseline Factors
CEA_GRID_EMISSION_FACTOR=0.716
