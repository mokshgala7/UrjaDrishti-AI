# Flask Server Settings
FLASK_APP=app.py
PORT=5001
HOST=0.0.0.0
DEBUG=True
SECRET_KEY=change-this-in-production-secret-key-2026

# Paths (defaults point to project relative paths)
# DATA_DIR=/path/to/UrjaDrishti-AI/ml/data
# ARTIFACTS_DIR=/path/to/UrjaDrishti-AI/ml/artifacts

# Local MySQL Database Configuration (Managed via MySQL Workbench)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=urjadrishti_ai
DB_USER=root
DB_PASSWORD=

# Optional Explicit DATABASE_URL (leave unset to use DB_* above)
# DATABASE_URL=mysql+pymysql://root:password@127.0.0.1:3306/urjadrishti_ai

# CORS Allowed Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,*

# Environmental Baseline Factors
CEA_GRID_EMISSION_FACTOR=0.716
